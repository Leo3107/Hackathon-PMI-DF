# Chave da OpenAI — usada pelo Agente Sintetizador e pelo Copiloto de Análise.
# Consumida APENAS em route handlers do servidor. Nunca exposta ao browser.
OPENAI_API_KEY=sk-proj-...

# Modelo usado na camada de linguagem natural.
LASTRO_LLM_MODEL=gpt-5.4-mini

# Liga/desliga a camada LLM. Em false, a app cai no gerador determinístico
# de narrativa e continua 100% funcional (kill switch de pitch).
LASTRO_LLM_ENABLED=true

# Teto rígido de gasto acumulado por processo, em dólares. Ao atingir,
# a API para de ser chamada e a app usa o gerador determinístico.
LASTRO_LLM_BUDGET_USD=8

# Preço por 1M de tokens, usado só para o contador de custo na interface.
LASTRO_LLM_PRICE_IN_PER_MTOK=0.25
LASTRO_LLM_PRICE_OUT_PER_MTOK=2.00
